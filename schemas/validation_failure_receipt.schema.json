{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fpdg/validation_failure_receipt.schema.json",
  "title": "FPDG validation failure receipt v0.1",
  "type": "object",
  "required": [
    "schema",
    "repository_id",
    "source_commit",
    "status",
    "failures"
  ],
  "properties": {
    "schema": {"const": "FPDG_VALIDATION_FAILURE_RECEIPT_V0_1"},
    "repository_id": {"enum": ["TIR", "IDT", "RFC", "SOH", "FPDG"]},
    "repository": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "workflow": {"type": "string"},
    "job": {"type": "string"},
    "run_id": {"type": ["integer", "string"]},
    "status": {"const": "FAIL"},
    "failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["failure_id", "kind"],
        "properties": {
          "failure_id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "VALIDATOR_FAILURE",
              "TEST_FAILURE",
              "RECEIPT_FAILURE",
              "CROSS_REPO_CONTRACT_FAILURE",
              "EQUATION_CHECK_FAILURE",
              "SYMBOL_CHECK_FAILURE",
              "SOURCE_ASSERTION_FAILURE"
            ]
          },
          "claim_id": {"type": "string", "minLength": 1},
          "expected": {},
          "observed": {},
          "message": {"type": "string"},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "source_locator": {
            "type": "object",
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "symbol": {"type": "string", "minLength": 1},
              "equation_id": {"type": "string", "minLength": 1},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1},
              "validator_id": {"type": "string", "minLength": 1},
              "test_id": {"type": "string", "minLength": 1},
              "receipt_ref": {"type": "string", "minLength": 1},
              "interface_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "anyOf": [
          {"required": ["claim_id"]},
          {"required": ["source_locator"]}
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
